# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Database
DATABASE_URL=postgresql://investkit:password@localhost:5432/investkit
DB_HOST=localhost
DB_PORT=5432
DB_NAME=investkit
DB_USER=investkit
DB_PASSWORD=password

# CORS (liste d'origines autorisées séparées par des virgules)
CORS_ORIGIN=http://localhost:3000

# hCaptcha (https://dashboard.hcaptcha.com) - clé secrète, associée à
# NEXT_PUBLIC_HCAPTCHA_SITEKEY côté frontend
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret-key

# Email Configuration
# Options: 'resend' (recommended), 'ethereal' (dev testing), 'smtp' (custom SMTP)
EMAIL_PROVIDER=ethereal
EMAIL_FROM=noreply@investkit.com

# Resend Configuration (https://resend.com)
# Sign up for free and get your API key
# RESEND_API_KEY=re_1234567890abcdef

# SMTP Configuration (for Gmail, Outlook, custom servers)
# Example for Gmail:
#   1. Enable 2FA on your Google account
#   2. Create an App Password at https://myaccount.google.com/apppasswords
#   3. Use that password here
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-character-app-password

# API Keys (optional)
# ALPHA_VANTAGE_KEY=your-api-key
# NEWS_API_KEY=your-api-key

# Frontend URL (redirections Stripe Checkout / Customer Portal)
FRONTEND_URL=http://localhost:3000

# Stripe (https://dashboard.stripe.com/apikeys) - Phase 2A, abonnement Pro
# 1. Créez un produit "InvestKit Pro" avec 2 prix récurrents :
#      - mensuel : 7,99€/mois
#      - annuel  : 79€/an
# 2. Copiez les Price IDs (commencent par "price_") ci-dessous
# 3. Créez un endpoint webhook (dashboard.stripe.com/webhooks) pointant vers
#      https://votre-domaine/api/v1/billing/webhook
#    en écoutant : checkout.session.completed, customer.subscription.updated,
#    customer.subscription.deleted, invoice.payment_failed
#    puis copiez son "Signing secret" (commence par "whsec_")
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_MONTHLY=price_...
# STRIPE_PRICE_ID_YEARLY=price_...
