# Copie ce fichier en backend/.env.local (ou définis ces variables dans le
# service systemd / le panneau de l'hébergeur). Rien n'est écrit en dur dans le code.

NODE_ENV=production
PORT=5000

# Base de données (au choix : DATABASE_URL, ou les 5 variables DB_*)
DATABASE_URL=postgresql://investkit:CHANGE_ME@localhost:5432/investkit
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=investkit
# DB_USER=investkit
# DB_PASSWORD=CHANGE_ME

# Sécurité : générer avec  openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_EXPIRES_IN=7d

# Chiffrement des champs sensibles au repos (secret 2FA) : générer avec  openssl rand -hex 32
# Sans cette valeur, la clé est dérivée de JWT_SECRET (avertissement au démarrage). Ne pas la changer après coup :
# les secrets 2FA déjà chiffrés deviendraient illisibles.
FIELD_ENCRYPTION_KEY=

# Origines autorisées (adresse PUBLIQUE du site, séparées par des virgules)
CORS_ORIGIN=https://ton-domaine.example
# Adresse publique du site (liens dans les emails, retours Stripe)
FRONTEND_URL=https://ton-domaine.example

# Emails : resend | smtp | ethereal (ethereal = test, n'envoie rien)
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@ton-domaine.example
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# Stripe (quand tu auras créé ton compte)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_MONTHLY=
# STRIPE_PRICE_ID_YEARLY=
