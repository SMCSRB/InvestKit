# Frontend (Next.js). ATTENTION : cette valeur est intégrée au site au moment
# du build (npm run build) ; si elle change, il faut reconstruire le site.
# Mets l'adresse PUBLIQUE de l'API, pas localhost.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# Le backend a son propre fichier : backend/.env.example
