# Copie ce fichier en « .env.dev » (ignoré par git) et remplis-le. Ne le publie JAMAIS, ne l'envoie à personne (voir docs/secrets.md).
DATABASE_URL=postgresql://investkit:CHANGE_ME@localhost:5432/investkit
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
FIELD_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# E-mails : « ethereal » = faux envoi pour tester (rien ne part). « smtp » = vrais e-mails (Gmail : mot de passe d'APPLICATION, jamais ton vrai mot de passe).
EMAIL_PROVIDER=ethereal
EMAIL_FROM=noreply@localhost
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=ton.adresse@gmail.com
# SMTP_PASS=
